{
	"name": "hslu-courses-skill-tree",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"catalog:generate": "bun scripts/generate-catalog.ts",
		"catalog:check": "bun scripts/generate-catalog.ts --check",
		"prebuild": "bun run catalog:check",
		"check": "bun run catalog:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome check --write .",
		"lint": "biome check .",
		"worker:types": "wrangler types worker/env.d.ts",
		"worker:dev": "wrangler dev --port 8787",
		"worker:test": "vitest run --config worker/vitest.config.ts",
		"worker:check": "tsc --noEmit -p worker/tsconfig.json",
		"worker:deploy": "wrangler deploy"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@cloudflare/vitest-pool-workers": "^0.21.3",
		"@iconify-json/lucide": "^1.2.112",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.65.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"@unocss/preset-icons": "^66.7.2",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"unocss": "^66.7.2",
		"vite": "^8.0.16",
		"vitest": "^4.1.10",
		"wrangler": "^4.123.0"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@xyflow/svelte": "^1.6.0",
		"better-auth": "^1.6.29",
		"driver.js": "^1.8.0"
	}
}
