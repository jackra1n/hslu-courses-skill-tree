{
	"name": "hslu-courses-skill-tree",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"catalog:generate": "bun scripts/generate-catalog.ts",
		"catalog:check": "bun scripts/generate-catalog.ts --check",
		"web:test": "bun run i18n:compile && bun test ./test",
		"e2e:test": "bun run build && playwright test",
		"e2e:check": "tsc --noEmit -p tsconfig.e2e.json",
		"e2e:types": "wrangler types e2e/env.d.ts --config e2e/wrangler.jsonc --env-interface E2EFrontendEnv --include-runtime=false",
		"i18n:check": "bun scripts/check-i18n.ts",
		"prebuild": "bun run catalog:check",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "bun run i18n:compile && bun run catalog:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check:watch": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "bun run i18n:compile && svelte-kit sync && eslint . --max-warnings=0",
		"unused": "knip",
		"worker:types": "wrangler types worker/env.d.ts",
		"worker:dev": "wrangler dev --port 8787",
		"worker:test": "vitest run --config worker/vitest.config.ts",
		"worker:check": "tsc --noEmit -p worker/tsconfig.json",
		"worker:deploy": "wrangler deploy"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@eslint/js": "^10.0.1",
		"@iconify-json/lucide": "^1.2.127",
		"@playwright/test": "^1.63.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.4.0",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"knip": "^6.37.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"unocss": "^66.8.1",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.127.1"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.25.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@xyflow/svelte": "^1.6.5",
		"better-auth": "^1.7.2",
		"driver.js": "^1.8.0"
	}
}
