{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/worker/env.d.ts",
			"!**/e2e/env.d.ts",
			"!**/hslu_data",
			"!**/templates",
			"!src/lib/paraglide"
		]
	},
	"assist": { "enabled": false },
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": { "enabled": true }
	},
	"linter": { "enabled": false },
	"overrides": [
		{
			"includes": ["src/lib/data/catalog.generated.json"],
			"formatter": {
				"lineWidth": 120
			}
		}
	]
}
